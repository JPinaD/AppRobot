<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tea_bg">

    <!-- Grid de pictogramas -->
    <GridLayout
        android:id="@+id/gridPictograms"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnCount="2"
        android:rowCount="2"
        android:padding="24dp"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true" />

    <!-- Confirmación visual (oculta por defecto) -->
    <LinearLayout
        android:id="@+id/layoutConfirmation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/tea_correct"
        android:visibility="gone">

        <View
            android:id="@+id/ivTick"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/ic_tick"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/tea_primary"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- FAB: Momento de calma -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCalm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/calm_fab_desc"
        app:srcCompat="@drawable/ic_calm"
        app:backgroundTint="@color/calm_fab_bg"
        app:tint="@null"
        app:fabSize="normal" />

</FrameLayout>
