<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/tea_bg"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvSelectedProfileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/tea_primary"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSelectedProfileDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:textColor="@color/tea_text_secondary"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <TextView
        android:id="@+id/tvWaitingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Esperando al terapeuta…"
        android:textSize="22sp"
        android:textColor="@color/tea_text_main"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/tvNetworkStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/network_status_waiting"
        android:textSize="15sp"
        android:textColor="@color/tea_text_secondary"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvBluetoothStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bt_status_connecting"
        android:textSize="15sp"
        android:textColor="@color/tea_text_secondary"
        android:gravity="center"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvBatteryStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/tea_text_secondary"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Salir"
        android:contentDescription="@string/back_content_desc"
        android:layout_marginTop="48dp"
        style="@style/TEA.Button.Outline" />

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_robot_name"
        android:contentDescription="@string/settings_robot_name"
        android:layout_marginTop="12dp"
        style="@style/TEA.Button.Outline" />

</LinearLayout>
