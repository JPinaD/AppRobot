<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AppRobot" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/tea_primary</item>
        <item name="colorPrimaryVariant">@color/tea_primary_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/tea_bg</item>
        <item name="android:textColorPrimary">@color/tea_text_main</item>
        <item name="android:textColorSecondary">@color/tea_text_secondary</item>
    </style>

    <!-- Botón TEA: grande, claro, sin bordes agresivos -->
    <style name="TEA.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="backgroundTint">@color/tea_button_bg</item>
        <item name="android:textColor">@color/tea_button_text</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Botón TEA secundario (outline) -->
    <style name="TEA.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textColor">@color/tea_primary</item>
        <item name="strokeColor">@color/tea_primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

</resources>
